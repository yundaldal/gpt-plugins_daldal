{
  "version": 1,
  "policy": {
    "every_question_requires_choice_and_custom_input": true,
    "do_not_reask_answered": true,
    "context_fields": ["type", "source", "missing", "conflict"]
  },
  "questions": [
    {"id":"type.confirm","stage":"intake","field_paths":["type"],"required_when":"type is missing or ambiguous","prompt":"자료를 기준으로 어떤 품의 유형으로 진행할까요?","options":[{"id":"recommended","label":"추천 유형으로 진행","value":"recommended"},{"id":"choose","label":"다른 유형 선택","value":"choose"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"intake.readiness","stage":"intake","field_paths":["source"],"required_when":"required source is missing","prompt":"준비점검을 어떻게 진행할까요?","options":[{"id":"continue","label":"현재 자료로 점검","value":"continue"},{"id":"add","label":"자료를 추가한 뒤 점검","value":"add"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"source.unreadable","stage":"source","field_paths":["source"],"required_when":"source cannot be read","prompt":"읽을 수 없는 자료를 어떻게 처리할까요?","options":[{"id":"replace","label":"읽을 수 있는 자료로 교체","value":"replace"},{"id":"manual","label":"내용을 직접 입력","value":"manual"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"source.conflict","stage":"source","field_paths":["source"],"required_when":"sources conflict","prompt":"서로 다른 자료의 충돌을 어떻게 해결할까요?","options":[{"id":"latest","label":"최신 자료 우선","value":"latest"},{"id":"confirm","label":"사용자 확인 후 결정","value":"confirm"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"field.confirm","stage":"confirmation","field_paths":["case"],"required_when":"extracted value affects output","prompt":"추출된 핵심 정보를 어떻게 확정할까요?","options":[{"id":"accept","label":"추출값 사용","value":"accept"},{"id":"edit","label":"직접 수정","value":"edit"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"travel.present","stage":"confirmation","field_paths":["allowance.people[].travel"],"required_when":"allowance exists and travel is unspecified","prompt":"교통비를 어떻게 반영할까요?","options":[{"id":"none","label":"없음","value":"none"},{"id":"amount","label":"금액 입력","value":"amount"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"attachment.include","stage":"confirmation","field_paths":["draft.attachments"],"required_when":"attachment scope is ambiguous","prompt":"제출용 붙임을 어떻게 구성할까요?","options":[{"id":"include","label":"제출용 붙임 포함","value":"include"},{"id":"exclude","label":"본문에서 제외","value":"exclude"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"rate.confirm","stage":"calculation","field_paths":["rate_confirmation"],"required_when":"allowance rate confirmation is missing","prompt":"기준 단가를 확인하고 계산을 진행할까요?","options":[{"id":"confirm","label":"기준 단가 확인","value":"confirm"},{"id":"review","label":"기준 자료 재검토","value":"review"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"recovery.txt","stage":"recovery","field_paths":["output"],"required_when":"HWPX generation fails","prompt":"HWPX 생성에 실패했습니다. 다음 중 어떻게 진행할까요?","options":[{"id":"retry","label":"HWPX 생성 재시도","value":"retry"},{"id":"preview","label":"본문 미리보기만 제공","value":"preview"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true}
  ]
}
