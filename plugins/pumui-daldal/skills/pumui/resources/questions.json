{
  "version": 1,
  "policy": {
    "every_question_requires_choice_and_custom_input": true,
    "do_not_reask_answered": true,
    "context_fields": ["type", "source", "missing", "conflict"],
    "custom_required_for": {"type.confirm":["choose"],"intake.readiness":["add"],"source.unreadable":["replace","manual"],"source.conflict":["confirm"],"rate.confirm":["review"],"travel.present":["amount"],"field.confirm":["edit"],"attachment.include":["edit"]},
    "allow_not_applicable": []
  },
  "questions": [
    {"id":"type.confirm","stage":"intake","field_paths":["type"],"required_when":"type is missing or ambiguous","prompt":"자료를 기준으로 어떤 품의 유형으로 진행할까요?","options":[{"id":"recommended","label":"추천 유형으로 진행","value":"recommended"},{"id":"choose","label":"다른 유형 선택","value":"choose"},{"id":"custom","label":"직접 입력","value":"custom"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"intake.readiness","stage":"intake","field_paths":["source"],"required_when":"required source is missing","prompt":"준비점검을 어떻게 진행할까요?","options":[{"id":"continue","label":"현재 자료로 점검","value":"continue"},{"id":"add","label":"자료를 추가한 뒤 점검","value":"add"},{"id":"custom","label":"직접 입력","value":"custom"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"source.unreadable","stage":"source","field_paths":["source"],"required_when":"source cannot be read","prompt":"읽을 수 없는 자료를 어떻게 처리할까요?","options":[{"id":"replace","label":"읽을 수 있는 자료로 교체","value":"replace"},{"id":"manual","label":"내용을 직접 입력","value":"manual"},{"id":"custom","label":"직접 입력","value":"custom"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"source.conflict","stage":"source","field_paths":["source"],"required_when":"sources conflict","repeatable_scopes":["session"],"prompt":"서로 다른 자료의 충돌을 어떻게 해결할까요?","options":[{"id":"latest","label":"최신 자료 우선","value":"latest"},{"id":"confirm","label":"사용자 확인 후 결정","value":"confirm"},{"id":"custom","label":"직접 입력","value":"custom"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"field.confirm","stage":"confirmation","field_paths":["case"],"required_when":"extracted value affects output","repeatable_scopes":["session"],"prompt":"추출된 핵심 정보를 어떻게 확정할까요?","options":[{"id":"accept","label":"추출값 사용","value":"accept"},{"id":"edit","label":"직접 수정","value":"edit"},{"id":"custom","label":"직접 입력","value":"custom"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"travel.present","stage":"confirmation","field_paths":["allowance.people[].travel"],"required_when":"allowance exists and travel is unspecified","repeatable_scopes":["person"],"prompt":"교통비를 어떻게 반영할까요?","options":[{"id":"none","label":"없음","value":"none"},{"id":"amount","label":"금액 입력","value":"amount"},{"id":"custom","label":"직접 입력","value":"custom"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"attachment.include","stage":"confirmation","field_paths":["draft.attachments"],"required_when":"attachment scope is ambiguous","prompt":"제출용 붙임 목록을 어떻게 확정할까요?","options":[{"id":"use","label":"현재 입력 목록 사용","value":"use"},{"id":"edit","label":"목록 수정","value":"edit"},{"id":"custom","label":"직접 입력","value":"custom"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true},
    {"id":"rate.confirm","stage":"calculation","field_paths":["rate_confirmation"],"required_when":"allowance rate confirmation is missing","prompt":"기준 단가를 확인하고 계산을 진행할까요?","options":[{"id":"confirm","label":"기준 단가 확인","value":"confirm"},{"id":"review","label":"기준 자료 재검토","value":"review"},{"id":"custom","label":"직접 입력","value":"custom"}],"custom_input":{"id":"custom","label":"직접 입력","value":"custom"},"blocks_generation":true}
  ]
}
